<configuration>
  <input><net-file value="net.net.xml"/><route-files value="routes_asis_am.rou.xml"/><additional-files value="vtypes.add.xml,detectors_asis_am.add.xml"/></input>
  <time><begin value="0"/><end value="5400"/><step-length value="1"/></time>
  <processing><time-to-teleport value="300"/></processing>
  <random_number><seed value="1"/></random_number>
  <output><tripinfo-output value="work/tripinfo_asis_am.xml"/><statistic-output value="work/stats_asis_am.xml"/></output>
  <report><no-step-log value="true"/><no-warnings value="true"/></report>
</configuration>